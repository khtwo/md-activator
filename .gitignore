# MD Activator — ignore rules for the released/public repository.
# Curated subset of the development .gitignore: only the artifacts a consumer
# generates by running the app or building the VS Code extension. release.bat
# copies this file into the release payload as ".gitignore".

# Python bytecode and caches
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/

# uv / Node build caches
.uv-cache/
node_modules/
vscode-extension/node_modules/

# Staged VS Code extension server payload (regenerated by the extension build)
vscode-extension/server/

# Local configuration and secrets
.env
.env.*
!.env.example

# Logs and runtime files
*.log
*.pid

# Editor and OS metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
